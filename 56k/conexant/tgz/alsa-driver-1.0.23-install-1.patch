diff -urN alsa-driver-1.0.23/reload-alsa-driver alsa-driver-1.0.23-install/reload-alsa-driver
--- alsa-driver-1.0.23/reload-alsa-driver	1969-12-31 19:00:00.000000000 -0500
+++ alsa-driver-1.0.23-install/reload-alsa-driver	2010-05-08 15:49:59.000000000 -0400
@@ -0,0 +1,187 @@
+#!/bin/sh
+#
+# Reloads all ALSA modules on the system, killing all applications which is
+# using the sound if necessary. This script is expected to be run after the
+# new kernel modules are installed and before depmod is ran (depmod will be
+# done by this script)
+#
+
+run_command()
+{
+	if ${do_debug}; then
+		echo "+ Running $@"
+	fi
+
+	eval $@
+
+	ret=$?
+
+	if ${do_debug} && [ ${ret} -ne 0 ]; then
+		echo "+ Returned ${ret}"
+	fi
+
+	return ${ret}
+}
+
+kill_procs()
+{
+	method=$1
+	majors=$2
+
+	perl - << EOF
+	my @tokill;
+
+	foreach (glob "/proc/[123456789]*") {
+		my \$pid = \$_;
+		foreach (glob \$pid . "/fd/*") {
+			my \$major = (stat)[6];
+			if (defined(\$major)) {
+				\$major >>= 8;
+				foreach \$match (qw/ ${majors} /) {
+					if (\$major == \$match) {
+						\$pid =~ s!^/proc/!!;
+						push(@tokill, int(\$pid));
+					}
+				}
+			}
+		}
+	}
+
+	if(@tokill) {
+		print "Sending ${method} signal to processes still using sound:\n";
+		system("ps -o pid,user,args -wp" . join(",", map sprintf("%d", \$_), @tokill));
+		kill ${method}, @tokill;
+	}
+EOF
+
+	return 0
+}
+
+unload_mods()
+{
+	FAILEDMODS=
+	failedret=0
+
+	for mod in $@; do
+		if ${do_debug}; then
+			run_command modprobe -r $mod
+		else
+			run_command modprobe -r $mod > /dev/null 2>&1
+		fi
+		ret=$?
+		if [ ${ret} -ne 0 ]; then
+			FAILEDMODS="$mod $FAILEDMODS"
+			failedret=${ret}
+		fi
+	done
+
+	if [ ${failedret} -ne 0 ]; then
+		ret=${failedret}
+	fi
+
+	return $ret
+}
+
+
+
+PATH=/usr/sbin:/sbin:/usr/bin:/bin:/usr/local/sbin:/usr/local/bin
+export PATH
+
+do_only_unload=false
+do_help=false
+do_debug=false
+
+for arg in $@; do
+	case "${arg}" in
+		-h|--help)
+			do_help=true
+			;;
+		-u)
+			do_only_unload=true
+			;;
+		-d|--debug)
+			do_debug=true
+			;;
+		*)
+			echo 2>&1 "$0: Unknown option \"${arg}\". Try \"$0 -h\" for more information."
+			exit 1
+			;;
+	esac
+done
+
+if ${do_help}; then
+	echo "Usage: $0 [ -h | --help] [-u] [-d]"
+	echo "Unload all sound modules from the kernel and reload them"
+	echo
+	echo "  -h, --help    Display this help and exit"
+	echo "  -u            Only unload sound modules, don't reload them"
+	echo "  -d, --debug   Display debugging information"
+
+	exit 0
+fi
+
+# Determine all ALSA modules that are loaded at the moment
+TOPLEVEL="`lsmod | awk '$0 ~ /^snd[-_]/ && $4 == "" { print $1 }'`"
+
+if [ -z "${TOPLEVEL}" ]; then
+	depmod
+	exit 0
+fi
+
+if ! unload_mods ${TOPLEVEL}; then
+	# At least one module failed to be unloaded, we assume that there is a process
+	# which is using ALSA at the moment, we will try to terminate this or these
+	# applications
+
+	maj="`awk '$2 ~ "alsa|sound" { print $1 }' /proc/devices`"
+
+	if [ -n "${maj}" ]; then
+		# Be gentle at first
+		kill_procs TERM "${maj}"
+		
+		for wait in 1 7 7; do
+			sleep ${wait}
+			unload_mods ${FAILEDMODS}
+			ret=$?
+			if [ ${ret} -eq 0 ]; then
+				break
+			fi
+		done
+
+		if [ ${ret} -ne 0 ]; then
+			# Last resort...
+			kill_procs KILL "${maj}"
+
+			for wait in 1 5; do
+				sleep ${wait}
+				unload_mods ${FAILEDMODS}
+				ret=$?
+				if [ ${ret} -eq 0 ]; then
+					break
+				fi
+			done
+		fi
+
+		if [ ${ret} -ne 0 ]; then
+			echo 2>&1 "ERROR: Can't unload ALSA modules from the kernel. Please reboot."
+			depmod
+			exit ${ret}
+		fi
+	else
+		echo 2>&1 "ERROR: Can't determine ALSA and OSS major device numbers. Please reboot."
+		depmod
+		exit 1
+	fi
+fi
+
+depmod
+
+if ! ${do_only_unload}; then
+	# Reload all modules we have removed from the kernel
+	for mod in ${TOPLEVEL}; do
+		run_command modprobe $mod
+	done
+fi
+
+exit 0
+
