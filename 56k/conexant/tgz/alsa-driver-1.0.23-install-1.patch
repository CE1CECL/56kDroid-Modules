--- alsa-driver-1.0.23/symvers-update	1969-12-31 19:00:00.000000000 -0500
+++ alsa-driver-1.0.23-install/symvers-update	2010-05-08 15:49:01.000000000 -0400
@@ -0,0 +1,45 @@
+#!/usr/bin/perl
+#
+# Copyright (c) 2007 Linuxant inc.
+#
+# Licensed under the GPL, see COPYING for details.
+#
+
+my $prog = "symvers-update";
+
+if (!defined($ARGV[0]) || !defined($ARGV[1]) || defined($ARGV[2])) {
+	print "Usage: $prog <original_file> <new_file>\n\n";
+	print "Updates original_file symvers with updated entries from new_file.\n";
+
+	exit 1;
+}
+
+open(ORIG, "<$ARGV[0]") || die "$prog: can't open '$ARGV[0]': $!";
+open(NEW, "<$ARGV[1]") || die "$prog: can't open '$ARGV[1]': $!";
+
+my %symdb;
+
+while (<ORIG>) {
+	my ($crc, $sym, $file, $type) = split /\t/;
+	$symdb{$sym} = "$crc\t$sym\t$file\t$type";
+}
+
+close ORIG;
+
+while (<NEW>) {
+	my ($crc, $sym, $file, $type) = split /\t/;
+	$symdb{$sym} = "$crc\t$sym\t$file\t$type";
+}
+
+close NEW;
+
+open(OUT, ">$ARGV[0]") || die "$prog: can't open '$ARGV[0]': $!";
+
+foreach (keys %symdb) {
+	print OUT $symdb{$_};
+}
+
+close OUT;
+
+exit 0;
+
