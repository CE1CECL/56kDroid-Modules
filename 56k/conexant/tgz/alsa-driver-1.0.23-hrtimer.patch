diff -urN --show-c-function alsa-driver-git20100411/configure.in alsa-driver-git20100411-hrtimer/configure.in
--- alsa-driver-git20100411/configure.in	2010-04-11 13:41:26.000000000 -0400
+++ alsa-driver-git20100411-hrtimer/configure.in	2010-04-11 15:56:03.000000000 -0400
@@ -2029,6 +2029,36 @@ if test "$CONFIG_HAVE_PCI_DEV_PRESENT" =
   AC_DEFINE(CONFIG_HAVE_PCI_DEV_PRESENT)
 fi
 
+dnl Check for hrtimer_get_expires
+AC_MSG_CHECKING(for hrtimer_get_expires)
+hrtimer_get_expires_defined="0"
+ac_save_CFLAGS="$CFLAGS"
+ac_save_CC="$CC"
+CFLAGS="$KERNEL_CHECK_CFLAGS -Werror-implicit-function-declaration"
+CC=$KCC
+AC_TRY_COMPILE([
+#define __KERNEL__
+#ifdef CONFIG_HAVE_DEPRECATED_CONFIG_H
+#include <linux/autoconf.h>
+#else
+#include <linux/config.h>
+#endif
+#include <linux/hrtimer.h>
+],[
+	struct hrtimer *timer;
+	hrtimer_get_expires(timer);
+],
+    AC_MSG_RESULT(yes);hrtimer_get_expires_defined="1",
+    AC_MSG_RESULT(no);hrtimer_get_expires_defined="0",
+    AC_MSG_RESULT(unknown);hrtimer_get_expires_defined="0"
+)
+CFLAGS=$ac_save_CFLAGS
+CC=$ac_save_CC
+CONFIG_HAVE_HRTIMER_GET_EXPIRES=$hrtimer_get_expires_defined
+if test "$CONFIG_HAVE_HRTIMER_GET_EXPIRES" = "1"; then
+  AC_DEFINE(CONFIG_HAVE_HRTIMER_GET_EXPIRES)
+fi
+
 dnl Check for msleep
 AC_MSG_CHECKING(for msleep)
 msleep="0"
diff -urN --show-c-function alsa-driver-git20100411/drivers/pcsp/pcsp_lib.c alsa-driver-git20100411-hrtimer/drivers/pcsp/pcsp_lib.c
--- alsa-driver-git20100411/drivers/pcsp/pcsp_lib.c	2008-11-28 11:41:50.000000000 -0500
+++ alsa-driver-git20100411-hrtimer/drivers/pcsp/pcsp_lib.c	2010-04-11 15:56:03.000000000 -0400
@@ -1,5 +1,5 @@
 #include "adriver.h"
-#if LINUX_VERSION_CODE < KERNEL_VERSION(2, 6, 28)
+#ifndef CONFIG_HAVE_HRTIMER_GET_EXPIRES
 #define hrtimer_get_expires(t)	(t)->expires
 #endif
 #include "../../alsa-kernel/drivers/pcsp/pcsp_lib.c"
diff -urN --show-c-function alsa-driver-git20100411/include/config.h.in alsa-driver-git20100411-hrtimer/include/config.h.in
--- alsa-driver-git20100411/include/config.h.in	2010-04-11 13:41:26.000000000 -0400
+++ alsa-driver-git20100411-hrtimer/include/config.h.in	2010-04-11 15:57:13.000000000 -0400
@@ -89,3 +89,4 @@
 #undef CONFIG_HAVE_PAGE_TO_PFN
 #undef CONFIG_HAVE_VIDEO_DRVDATA
 #undef CONFIG_HAVE_GENERATED_AUTOCONF_H
+#undef CONFIG_HAVE_HRTIMER_GET_EXPIRES
