+++ alsa-driver-git20100411-adriver_fmode/include/adriver.h	2010-04-18 17:13:48.000000000 -0400
@@ -109,7 +109,7 @@ typedef __u32 __be32;
 
 /* other missing types */
 #if LINUX_VERSION_CODE < KERNEL_VERSION(2, 6, 28)
-#if !defined(RHEL_RELEASE_CODE) || RHEL_RELEASE_CODE < RHEL_RELEASE_VERSION(5, 4)
+#ifndef CONFIG_HAVE_FMODE_T
 typedef unsigned int fmode_t;
 #endif
 #endif
